
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #fff;
  font-family: Arial, sans-serif;
}

/* Main illustration container */
.scene {
  position: relative;
  width: min(1200px, 100%);
  aspect-ratio: 1 / 1;
  overflow: hidden;
}

/* Pink background circle */
.background-circle {
  position: absolute;
  width: 95%;
  height: 92%;
  left: 2%;
  top: 3%;
  border-radius: 50%;
  background: #f9dafa;
}

/* Computer */
.computer {
  position: absolute;
  width: 86%;
  height: 58%;
  left: 7%;
  top: 26%;
  z-index: 2;
}

.screen {
  position: relative;
  width: 100%;
  height: 94%;
  border: 14px solid #252268;
  border-radius: 35px 35px 15px 15px;
  background: linear-gradient(
    115deg,
    #ffd98b,
    #ffed75,
    #ffd94c
  );
  box-shadow: inset 0 0 0 8px #f8b74f;
}

/* Computer screen's bottom base */
.computer-base {
  position: absolute;
  width: 112%;
  height: 10%;
  left: -6%;
  bottom: -5%;
  border-radius: 3px;
  background: #292b79;
}

/* Programming language circles */
.bubble {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #4fd7f3, #4697f5);
  color: #22236c;
  font-weight: bold;
  text-align: center;
  z-index: 3;
}

.head-one {
  width: 17%;
  aspect-ratio: 1;
  top: -7%;
  left: 28%;
  font-size: clamp(13px, 3vw, 40px);
}

.head-two {
  width: 19%;
  aspect-ratio: 1;
  top: 22%;
  left: 9%;
  font-size: clamp(13px, 3.5vw, 42px);
}

.javascript {
  width: 22%;
  aspect-ratio: 1;
  top: -7%;
  left: 60%;
  font-size: clamp(17px, 4vw, 48px);
  line-height: 1.4;
}

.cpp {
  width: 22%;
  aspect-ratio: 1;
  top: 30%;
  left: 73%;
  font-size: clamp(24px, 5vw, 62px);
}

.php {
  width: 17%;
  aspect-ratio: 1;
  top: 67%;
  left: 20%;
  font-size: clamp(22px, 4.5vw, 55px);
}

.html {
  width: 18%;
  aspect-ratio: 1;
  top: 76%;
  left: 46%;
  font-size: clamp(15px, 3.5vw, 40px);
}

/* Central coding icon */
.code-circle {
  position: absolute;
  width: 29%;
  aspect-ratio: 1;
  left: 34%;
  top: 21%;
  border-radius: 50%;
  background: white;
  color: #252268;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: clamp(35px, 7vw, 85px);
  font-weight: bold;
  z-index: 4;
}

/* Common person styling */
.person {
  position: absolute;
  z-index: 5;
}

/* Top person */
.person-top {
  width: 28%;
  height: 24%;
  left: 11%;
  top: 12%;
  transform: rotate(-5deg);
}

.person-top .body {
  position: absolute;
  width: 90%;
  height: 42%;
  left: 5%;
  top: 35%;
  border-radius: 50% 25% 10% 15%;
  background: linear-gradient(120deg, #e94291, #a51b70);
}

.person-top .face {
  position: absolute;
  width: 18%;
  height: 23%;
  top: 12%;
  left: 63%;
  background: #ffb36f;
  border-radius: 45%;
  transform: rotate(15deg);
}

.person-top .hair {
  position: absolute;
  width: 22%;
  height: 17%;
  top: 8%;
  left: 61%;
  border-radius: 50% 50% 35% 30%;
  background: #211b62;
  z-index: 2;
}

/* Laptop at the top */
.laptop {
  position: absolute;
  width: 30%;
  height: 29%;
  background: linear-gradient(130deg, #26246f, #090c38);
  border-radius: 12px;
  transform: skew(-23deg);
}

.laptop-top {
  left: 84%;
  top: 44%;
}

/* Left person */
.person-left {
  width: 26%;
  height: 37%;
  left: 2%;
  top: 56%;
}

.person-left .hair {
  position: absolute;
  width: 48%;
  height: 30%;
  left: 9%;
  top: 4%;
  border-radius: 55% 50% 35% 35%;
  background: #21145d;
}

.person-left .face {
  position: absolute;
  width: 16%;
  height: 15%;
  left: 32%;
  top: 12%;
  border-radius: 45%;
  background: #a73d24;
}

.person-left .body {
  position: absolute;
  width: 47%;
  height: 42%;
  left: 9%;
  top: 23%;
  border-radius: 60% 35% 10% 20%;
  background: linear-gradient(130deg, #f14b9a, #b9297c);
  transform: rotate(15deg);
}

.laptop-left {
  width: 57%;
  height: 23%;
  left: 27%;
  top: 42%;
  transform: skew(-20deg);
  background: #292b79;
}

/* Right person */
.person-right {
  width: 30%;
  height: 49%;
  right: 4%;
  top: 51%;
}

.person-right .hair {
  position: absolute;
  width: 18%;
  height: 12%;
  top: 0;
  left: 60%;
  border-radius: 50%;
  background: #20154f;
}

.person-right .face {
  position: absolute;
  width: 14%;
  height: 12%;
  left: 62%;
  top: 8%;
  border-radius: 40%;
  background: #ffae73;
}

.person-right .body {
  position: absolute;
  width: 62%;
  height: 42%;
  left: 20%;
  top: 22%;
  border-radius: 25% 35% 10% 20%;
  background: linear-gradient(130deg, #df247b, #a21b76);
  transform: rotate(8deg);
}

.person-right .legs {
  position: absolute;
  width: 35%;
  height: 46%;
  left: 45%;
  top: 58%;
  border-radius: 10px;
  background: linear-gradient(90deg, #6b27e6, #4535d9);
  transform: skew(-7deg);
}

/* Pointer held by right person */
.pointer {
  position: absolute;
  width: 3px;
  height: 31%;
  left: 1%;
  top: -20%;
  border-radius: 5px;
  background: #302b7b;
  transform: rotate(-45deg);
  transform-origin: bottom;
}

/* Graduation cap */
.graduation-cap {
  position: absolute;
  width: 27%;
  height: 20%;
  right: 1%;
  top: 12%;
  z-index: 7;
  transform: rotate(12deg);
}

.cap-top {
  position: absolute;
  width: 100%;
  height: 65%;
  top: 0;
  background: linear-gradient(130deg, #438ff7, #4051f5);
  clip-path: polygon(0 25%, 70% 0, 100% 45%, 30% 100%);
  border-radius: 12px;
}

.cap-base {
  position: absolute;
  width: 68%;
  height: 45%;
  top: 40%;
  left: 20%;
  border-radius: 0 0 50% 50%;
  background: #3939f4;
  z-index: -1;
}

.tassel {
  position: absolute;
  width: 4px;
  height: 65%;
  right: 17%;
  top: 35%;
  background: #252268;
  transform: rotate(10deg);
}

/* Smaller screens */
@media (max-width: 600px) {
  .screen {
    border-width: 7px;
    border-radius: 20px;
  }

  .computer {
    top: 29%;
  }

  .computer-base {
    height: 8%;
  }
}
